-- Template for changing PeopleSoft Access Password
-- Placeholders:
--   %%NEW_PASSWORD%%: The new plaintext password to be encrypted.
--   %%ACCESS_ID%%: The Access ID to be updated (e.g., SYSADM).
--   %%DMS_LOG_FILE%%: The path for the Data Mover log file.

SET LOG %%DMS_LOG_FILE%%;
SET NO TRACE;

ENCRYPT_PASSWORD %%NEW_PASSWORD%%;

UPDATE PSACCESSPROFILE
   SET ACCESSPSWD = :ACCESSPSWD
 WHERE ACCESSID = '%%ACCESS_ID%%';

COMMIT;
